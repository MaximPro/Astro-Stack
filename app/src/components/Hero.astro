---
import HeroContent from './HeroContent';

interface Props {
  headline: string;
  subheadline: string;
  ctaText?: string;
  ctaLink?: string;
  backgroundImage?: string;
}

const {
  headline,
  subheadline,
  ctaText = 'Jetzt anfangen',
  ctaLink = '#contact',
  backgroundImage,
} = Astro.props;
---

<section class="hero" id="hero">
  <div class="hero__background">
    {
      backgroundImage && (
        <img
          src={backgroundImage}
          alt=""
          class="hero__bg-image"
          loading="eager"
        />
      )
    }
    <div class="hero__gradient"></div>
  </div>

  <div class="container hero__content">
    <HeroContent
      client:load
      headline={headline}
      subheadline={subheadline}
      ctaText={ctaText}
      ctaLink={ctaLink}
    />
  </div>

  <!-- Scroll indicator -->
  <div class="hero__scroll-indicator">
    <span>Scroll</span>
    <div class="hero__scroll-arrow"></div>
  </div>
</section>

<script>
  import { heroParallax } from '@/lib/animations';

  document.addEventListener('astro:page-load', () => {
    // GSAP parallax effect on background
    heroParallax('.hero__bg-image');
  });
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__background {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(0, 102, 255, 0.1) 0%,
      rgba(0, 212, 255, 0.05) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 10;
    text-align: center;
    padding-block: var(--spacing-3xl);
  }

  .hero__scroll-indicator {
    position: absolute;
    bottom: var(--spacing-xl);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    animation: bounce 2s infinite;
  }

  .hero__scroll-arrow {
    width: 24px;
    height: 24px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
  }

  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    40% {
      transform: translateX(-50%) translateY(-10px);
    }
    60% {
      transform: translateX(-50%) translateY(-5px);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 90vh;
    }

    .hero__scroll-indicator {
      bottom: var(--spacing-lg);
    }
  }
</style>
