# Astro Configuration
PUBLIC_SITE_URL=https://yourdomain.com

# TinaCMS (optional - for visual editing)
TINA_CLIENT_ID=your_tina_client_id
TINA_TOKEN=your_tina_token
TINA_BRANCH=main

# n8n Webhook (optional - for lead automation)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/hot-lead

# Analytics (optional)
# PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# PUBLIC_UMAMI_WEBSITE_ID=your_umami_id
