{
  "name": "astro-bmad-stack",
  "version": "1.0.0",
  "description": "Optimized Astro Stack with BMAD-METHOD for rapid website development",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "bmad:install": "npx bmad-method@alpha install",
    "bmad:status": "npx bmad-method@alpha status",
    "bmad:menu": "echo 'Load the BMad Master agent in Claude Code and run */workflow-init'",
    "setup": "npm install && npm run bmad:install"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^3.6.2",
    "@astrojs/tailwind": "^5.1.2",
    "astro": "^5.15.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "bmad-method": "^6.0.0-alpha.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "astro",
    "bmad-method",
    "react",
    "tailwind",
    "claude-code",
    "ai-development",
    "rapid-development"
  ]
}
